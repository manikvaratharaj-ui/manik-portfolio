# Canonical URL of the deployed site (no trailing slash). Required.
# Used for the canonical tag, Open Graph, sitemap, robots and structured data.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Optional: Google Analytics 4 measurement ID. Leave empty to load no analytics.
NEXT_PUBLIC_GA_ID=

# Optional: Google Search Console "HTML tag" verification code (the content="..." value only).
NEXT_PUBLIC_GSC_VERIFICATION=
